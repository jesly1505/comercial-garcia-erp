# ==========================================
# COMERCIAL GARCIA ERP - CONFIGURACION GLOBAL
# ==========================================

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=comercial_garcia_erp
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/comercial_garcia_erp?schema=public"

# Servidor Backend
PORT=3000
NODE_ENV=production

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_comercial_garcia_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_comercial_garcia_2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes Permitidos CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost

# Frontend
VITE_API_URL=http://localhost:3000/api

# Mobile Expo
EXPO_PUBLIC_API_URL=http://localhost:3000/api
